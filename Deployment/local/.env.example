JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Comma-separated browser origins allowed to call this API (scheme+host+port must match exactly,
# e.g. https://590stcafe.com,https://admin.590stcafe.com) — defaults to localhost:3000/3001 when
# unset, which blocks every real deployed frontend. Must be set for production.
CORS_ALLOWED_ORIGINS=

# Reserved for admin login; use a different email in the customer signup form.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_EMAIL=
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_ACCOUNT_INFORMATION=
BAKONG_ACQUIRING_BANK=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=
BAKONG_MERCHANT_CATEGORY_CODE=5999
BAKONG_STORE_LABEL=
BAKONG_TERMINAL_LABEL=
BAKONG_PURPOSE_OF_TRANSACTION=Payment
BAKONG_CURRENCY=
BAKONG_EXPIRATION_MINUTES=

MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
